---
import { BlurFade } from "./ui/blur-fade";
import { credentials } from "../lib/data";
---

<section id="credentials" class="bg-background px-6 py-24 md:px-12 md:py-32">
  <div class="mx-auto max-w-7xl">
    <BlurFade client:visible inView>
      <p class="mb-3 font-body text-[0.72rem] tracking-[0.1em] text-muted-foreground uppercase">{credentials.eyebrow}</p>
      <h2 class="mb-14 font-display text-5xl md:text-7xl text-foreground">{credentials.heading}</h2>

      <div class="grid grid-cols-1 gap-x-10 gap-y-10 md:grid-cols-2">
        {
          credentials.items.map((item) => (
            <div class="border-t border-border pt-6">
              <h3 class="mb-1.5 font-display text-[1.15rem] text-foreground">{item.title}</h3>
              <p class="font-body text-[0.78rem] tracking-[0.02em] text-muted-foreground">{item.org}</p>
            </div>
          ))
        }
      </div>
    </BlurFade>
  </div>
</section>
